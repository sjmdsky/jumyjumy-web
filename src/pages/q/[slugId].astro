---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Logo from '../../components/Logo.astro'
import { buildPath, isIdLookupSegment } from '../../lib/slug'
import { renderAnswer } from '../../lib/markdown'
import { fetchQuestion, resolveCanonicalRedirect } from '../../lib/api'
import { toInlineJsonLd } from '../../lib/json-ld'
import { formatTimestamp } from '../../lib/datetime'
import { buildExcerpt } from '../../lib/excerpt'
import { API_BASE_URL, GATEWAY_TOKEN } from 'astro:env/server'

const slugId = Astro.params.slugId ?? ''

// 不是「按 id 查」的段，就是一句原始提问：后端要调模型，慢到足以把 SSR 拖成 502。
// 改渲染骨架页（rewrite 不改 URL），把等待交给浏览器，答案生成后再跳规范路径。
// 判定必须用 isIdLookupSegment 而非 parseSlugId——后者不排空白，与后端的分流规则不符。
if (!isIdLookupSegment(slugId)) {
  return Astro.rewrite(`/q/pending/${encodeURIComponent(slugId)}`)
}

// 请求时向后端取数：/q/<query> -> <API_BASE_URL>/q/<query>
//
// 透传访客的 UA：Worker 的出站 fetch 默认不带这个头，而后端把「无 UA」判定
// 为爬虫。不带就等于告诉后端每一位访客都是爬虫，访问量一个都记不上。
//
// 一并透传访客的真实 IP：后端按 IP 限流，而它收到的 cf-connecting-ip 是
// Cloudflare 在「Worker 打后端」这一跳上写的，也就是 Worker 自己的地址，
// 所有访客在后端眼里共用一个限流桶。访客的真实 IP 只有这一跳知道。
// 密钥随行，否则后端不采信——那个头谁都能写。
const result = await fetchQuestion(API_BASE_URL, slugId, {
  userAgent: Astro.request.headers.get('user-agent'),
  clientIp: Astro.request.headers.get('cf-connecting-ip'),
  gatewayToken: GATEWAY_TOKEN,
})

// 问题不存在必须发真 404。返回 200 空页就是 soft 404，会拖累全站抓取预算。
if (result.kind === 'notFound') {
  return new Response(null, { status: 404 })
}

// 后端故障与「不存在」严格区分：502 让搜索引擎稍后重试，不会把已收录页面剔出索引。
if (result.kind === 'error') {
  console.error(`[q/${slugId}] ${result.message}`)
  return new Response('Upstream unavailable', { status: 502 })
}

const question = result.question

// slug 过期（标题改过）或首页跳来的原始提问文本 -> 301 到规范路径，外链权重不丢。
const canonicalRedirect = resolveCanonicalRedirect(slugId, question)
if (canonicalRedirect) {
  return Astro.redirect(canonicalRedirect, 301)
}

const canonicalPath = buildPath(question.title, question.id)
const canonicalUrl = new URL(canonicalPath, Astro.site || 'https://example.com').href
// 默认信任答案质量：不做长度/来源/时效门禁。
// 仍然排除两类页面——尚未生成答案的 pending，以及人工降级的 demoted。
const indexable = question.status === 'ready' && !question.demoted

// 只有已就绪且可索引的页面允许被边缘缓存，用以抵消 SSR 的 TTFB 代价；
// pending / demoted 状态随时可能翻转，必须每次回源。
Astro.response.headers.set(
  'cache-control',
  indexable ? 'public, s-maxage=60, stale-while-revalidate=600' : 'private, no-store',
)

const renderedContent = renderAnswer(question.answerMarkdown)

// 分享卡片的摘要取答案正文，不取标题。微信卡片的标题与摘要是上下两栏，喂同一
// 句话进去，转发出去就是同一行文字重复两遍——这正是改动前的样子。
// 答案缺失时给 undefined，让 BaseLayout 回落到站点默认文案；**不回落到标题**，
// 那会把刚消掉的重复又带回来。
const shareDescription = buildExcerpt(question.answerMarkdown) || undefined

// 页脚那张 share-card.png 是功能性元素，不是装饰。它是方形品牌砖——
// icon.svg 的圆角深色底加 logo-dark.svg 的完整字标，取值理由见 BaseLayout。
//
// 微信的链接卡片缩略图是从正文 DOM 里挑一张真实图片，它不读 og:image——而在
// 这张图加进来之前，全站渲染出的 HTML 里一张图都没有（Logo 是内联 SVG），
// 所以转发出去的卡片只有一块灰底。
//
// 由这个用途派生出三条约束，改动前先读完：
//   1. 必须真的渲染出来。设成 display:none 的图微信会跳过。
//   2. 不加 loading="lazy"。缩略图能不能被取到是这次改动的全部目的，不值得
//      为省 8 KB 去赌一条没有文档、还随版本变的启发式。
//   2b. 必须是 PNG，不能直接引 logo.svg：微信的缩略图不接受 SVG，而单份位图
//      也跟不了主题切换。页面上看到的是同一个字标，只是栅格化并带上了底。
//   2c. 渲染尺寸别再调小。字标在 96px 上刚好读得出，再小就只剩一团色块，
//      而「能读出名字」正是用完整字标而非 JJ 图标的理由。
//   3. 页面上不要出现第二个图片标签，也不要在注释里写出那五个字符——
//      按字符串扫描的挑图逻辑会先撞上它，然后发现没有 src。
// 源文件是 600x600，微信取的是源文件，跟它在页面上渲染成多大无关。

// 服务端渲染 UTC，客户端脚本再换成访客本地时区（见 lib/datetime.ts）。
const updatedIso = new Date(question.updatedAt).toISOString()
const updatedLabel = formatTimestamp(question.updatedAt)

// Schema.org QAPage 结构化数据
const schemaJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'QAPage',
  mainEntity: {
    '@type': 'Question',
    name: question.title,
    text: question.title,
    answerCount: 1,
    acceptedAnswer: {
      '@type': 'Answer',
      text: question.answerMarkdown,
      url: canonicalUrl,
      datePublished: new Date(question.createdAt).toISOString(),
      dateModified: new Date(question.updatedAt).toISOString(),
    },
  },
}
---

<BaseLayout
  title={`${question.title} — JumyJumy`}
  description={shareDescription}
  noindex={!indexable}
  canonicalUrl={canonicalUrl}
>
  <!-- Schema.org JSON-LD for Google Rich Results -->
  <script is:inline type="application/ld+json" set:html={toInlineJsonLd(schemaJsonLd)} />

  <header class="detail-header">
    <div class="header-inner">
      <a href="/" class="brand-link" aria-label="JumyJumy Home">
        <Logo size="header" />
      </a>

      <!-- 顶部搜索框。刻意留空，与首页一致：这里是提新问题的入口，不是改这一题的入口 -->
      <form class="header-search-form" action="#" method="GET">
        <div class="header-search-streamer">
          <div class="streamer-glow" aria-hidden="true"></div>
          <div class="header-input-group">
            <input
              type="text"
              name="q"
              class="header-search-input"
              required
              autocomplete="off"
              placeholder="Real-time AI Search"
              aria-label="Search or ask anything"
            />
            <button type="submit" class="header-submit-btn" aria-label="Search">
              <svg
                class="header-arrow-icon"
                viewBox="0 0 24 24"
                width="16"
                height="16"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M5 12h14"></path>
                <path d="m12 5 7 7-7 7"></path>
              </svg>
            </button>
          </div>
        </div>
      </form>
    </div>
  </header>

  <main class="detail-container">
    <article class="qa-article">
      <header class="article-header">
        <h1 class="question-title">{question.title}</h1>
        <div class="meta-row">
          <span class="meta-label">Updated</span>
          <time datetime={updatedIso} data-local-time>{updatedLabel}</time>
          {question.tags && question.tags.length > 0 && (
            <>
              <span class="meta-dot">·</span>
              <div class="tag-list">
                {question.tags.map((tag) => (
                  <span class="tag-pill">{tag}</span>
                ))}
              </div>
            </>
          )}
        </div>
      </header>

      <div class="answer-body" set:html={renderedContent} />

      {question.sources.length > 0 && (
        <section class="sources-section">
          <h2 class="sources-title">Sources & References</h2>
          <ol class="sources-list">
            {question.sources.map((source) => (
              <li class="source-item">
                <a
                  href={source.url}
                  target="_blank"
                  rel="nofollow noopener"
                  class="source-link"
                >
                  <span class="source-title">{source.title}</span>
                  <svg class="external-icon" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                    <polyline points="15 3 21 3 21 9"></polyline>
                    <line x1="10" y1="14" x2="21" y2="3"></line>
                  </svg>
                </a>
              </li>
            ))}
          </ol>
        </section>
      )}
    </article>
  </main>

  <footer class="detail-footer">
    <div class="footer-inner">
      <!-- 功能性元素，不是装饰：微信的卡片缩略图取自这里。理由见 frontmatter -->
      <img
        src="/share-card.png"
        alt="JumyJumy"
        width="96"
        height="96"
        class="footer-mark"
        decoding="async"
      />
      <a href="/" class="back-home-link">← Return to Search</a>
    </div>
  </footer>
</BaseLayout>

<script>
  import { formatTimestamp } from '../../lib/datetime'

  // 服务端渲染的是 UTC（同一份 HTML 才能进边缘缓存）。这里换成访客本地时区；
  // 权威值始终是 datetime 属性里的 ISO 瞬时值，脚本只改人读的那一份。
  const localZone = Intl.DateTimeFormat().resolvedOptions().timeZone
  document.querySelectorAll<HTMLTimeElement>('time[data-local-time]').forEach((el) => {
    const ms = Date.parse(el.dateTime)
    if (Number.isNaN(ms)) return
    el.textContent = formatTimestamp(ms, localZone)
  })

  const form = document.querySelector('.header-search-form') as HTMLFormElement | null
  const input = document.querySelector('.header-search-input') as HTMLInputElement | null

  if (form && input) {
    form.addEventListener('submit', (e) => {
      e.preventDefault()
      const query = input.value.trim()
      if (!query) return

      // 直接把原始提问放进路径。该 URL 不是 id 形态，服务端立即回骨架页，
      // 由浏览器等后端解析（指纹去重 / 新建），再 replace 到 /q/<slug>-<id>。
      window.location.href = `/q/${encodeURIComponent(query)}`
    })
  }
</script>

<style>
  /* 顶部极简导航条 */
  .detail-header {
    border-bottom: 1px solid var(--color-border);
    background-color: var(--color-bg);
    position: sticky;
    top: 0;
    z-index: 10;
    backdrop-filter: blur(8px);
  }

  .header-inner {
    max-width: 760px;
    margin: 0 auto;
    padding: 0.85rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .brand-link {
    display: inline-flex;
    align-items: center;
    color: var(--color-text-primary);
    user-select: none;
    transition: opacity 0.15s ease;
    flex-shrink: 0;
  }

  .brand-link:hover {
    opacity: 0.85;
  }

  /* 顶部宽幅搜索框 */
  .header-search-form {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    min-width: 0;
  }

  /* 顶部流光搜索框容器与品牌渐变配色 */
  .header-search-streamer {
    --stream-c1: #f59e0b;
    --stream-c2: #f97316;
    --stream-c3: #fb7185;
    --stream-glow-c1: rgba(245, 158, 11, 0.28);
    --stream-glow-c2: rgba(249, 115, 22, 0.35);
    --stream-glow-c3: rgba(251, 113, 133, 0.28);
    --stream-base: var(--color-border);
    position: relative;
    width: 100%;
    max-width: 500px;
    border-radius: var(--radius-full);
  }

  @media (prefers-color-scheme: dark) {
    .header-search-streamer {
      --stream-c1: #fbbf24;
      --stream-c2: #fb923c;
      --stream-c3: #f43f5e;
      --stream-glow-c1: rgba(251, 191, 36, 0.25);
      --stream-glow-c2: rgba(251, 146, 60, 0.32);
      --stream-glow-c3: rgba(244, 63, 94, 0.25);
    }
  }

  /* 柔和的环境流光弥散光晕 (Ambient Streamer Glow) */
  .header-search-streamer .streamer-glow {
    position: absolute;
    inset: -2px;
    border-radius: var(--radius-full);
    background: linear-gradient(
      90deg,
      transparent 0%,
      transparent 20%,
      var(--stream-glow-c1) 42%,
      var(--stream-glow-c2) 52%,
      var(--stream-glow-c3) 62%,
      transparent 82%,
      transparent 100%
    );
    background-size: 200% 100%;
    animation: border-stream-glow 4.5s linear infinite;
    filter: blur(8px);
    opacity: 0.38;
    pointer-events: none;
    transition: opacity 0.25s ease, filter 0.25s ease;
  }

  .header-search-streamer:hover .streamer-glow {
    opacity: 0.65;
    filter: blur(10px);
  }

  .header-search-streamer:focus-within .streamer-glow {
    opacity: 0.9;
    filter: blur(12px);
  }

  .header-input-group {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    width: 100%;
    background-color: var(--color-bg-subtle);
    border-radius: var(--radius-full);
    border: 1.5px solid transparent;
    background-image:
      linear-gradient(var(--color-bg-subtle), var(--color-bg-subtle)),
      linear-gradient(
        90deg,
        var(--stream-base) 0%,
        var(--stream-base) 20%,
        var(--stream-c1) 42%,
        var(--stream-c2) 52%,
        var(--stream-c3) 62%,
        var(--stream-base) 82%,
        var(--stream-base) 100%
      );
    background-origin: padding-box, border-box;
    background-clip: padding-box, border-box;
    background-size: 100% 100%, 200% 100%;
    background-repeat: no-repeat, repeat-x;
    animation: border-stream-border 4.5s linear infinite;
    padding: 0.4rem 0.65rem 0.4rem 1.15rem;
    box-shadow: var(--shadow-sm);
    transition: box-shadow 0.2s cubic-bezier(0.16, 1, 0.3, 1), background-image 0.2s ease;
  }

  .header-input-group:hover {
    box-shadow: var(--shadow-md);
  }

  .header-input-group:focus-within {
    background-image:
      linear-gradient(var(--color-bg-input), var(--color-bg-input)),
      linear-gradient(
        90deg,
        var(--stream-base) 0%,
        var(--stream-base) 20%,
        var(--stream-c1) 42%,
        var(--stream-c2) 52%,
        var(--stream-c3) 62%,
        var(--stream-base) 82%,
        var(--stream-base) 100%
      );
    box-shadow: 0 0 0 3px rgba(249, 115, 22, 0.12), var(--shadow-md);
  }

  @media (prefers-color-scheme: dark) {
    .header-input-group:focus-within {
      box-shadow: 0 0 0 3px rgba(251, 146, 60, 0.18), var(--shadow-md);
    }
  }

  .header-search-input {
    flex: 1;
    min-width: 0;
    border: none;
    background: transparent;
    font-size: 0.925rem;
    font-weight: 450;
    color: var(--color-text-primary);
    outline: none;
    padding: 0.15rem 0;
  }

  .header-search-input::placeholder {
    color: var(--color-text-placeholder);
    font-size: 0.85rem;
    opacity: 1;
  }

  .header-submit-btn {
    appearance: none;
    -webkit-appearance: none;
    background: transparent;
    border: none;
    outline: none;
    padding: 0;
    margin-left: 0.4rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-secondary);
    transition: color 0.18s ease, transform 0.18s ease;
    flex-shrink: 0;
  }

  .header-submit-btn:hover {
    color: var(--color-text-primary);
    transform: translateX(2px);
  }

  .header-arrow-icon {
    display: block;
    width: 16px;
    height: 16px;
  }

  /* 核心主体内容区 */
  .detail-container {
    flex: 1;
    max-width: 760px;
    width: 100%;
    margin: 0 auto;
    padding: 3.5rem 1.5rem 6rem;
  }

  .qa-article {
    width: 100%;
  }

  .article-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--color-border);
  }

  .question-title {
    font-size: clamp(2rem, 4vw + 0.3rem, 2.75rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.22;
    color: var(--color-text-primary);
    margin-bottom: 1.15rem;
    text-wrap: balance;
    word-break: break-word;
  }

  .meta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem 0.75rem;
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  .meta-label {
    font-weight: 600;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-secondary);
  }

  .meta-row time {
    color: var(--color-text-secondary);
    font-variant-numeric: tabular-nums;
  }

  .meta-dot {
    color: var(--color-border-hover);
    user-select: none;
  }

  .tag-list {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    align-items: center;
  }

  .tag-pill {
    font-size: 0.75rem;
    font-weight: 550;
    letter-spacing: 0.01em;
    padding: 0.18rem 0.6rem;
    border-radius: var(--radius-full);
    background-color: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    transition: border-color 0.15s ease, color 0.15s ease, background-color 0.15s ease;
  }

  .tag-pill:hover {
    border-color: var(--color-border-hover);
    color: var(--color-text-primary);
    background-color: var(--color-bg-input);
  }

  /* 渲染答案主体排版 */
  .answer-body {
    font-size: 1.125rem;
    line-height: 1.82;
    color: var(--color-text-primary);
    word-break: break-word;
  }

  .answer-body :global(h1),
  .answer-body :global(h2),
  .answer-body :global(h3),
  .answer-body :global(h4),
  .answer-body :global(h5),
  .answer-body :global(h6) {
    color: var(--color-text-primary);
    letter-spacing: -0.025em;
    line-height: 1.3;
    font-weight: 700;
    text-wrap: balance;
  }

  .answer-body :global(h1) {
    font-size: 1.65rem;
    margin-top: 2.75rem;
    margin-bottom: 0.9rem;
  }

  .answer-body :global(h2) {
    font-size: 1.45rem;
    margin-top: 2.5rem;
    margin-bottom: 0.8rem;
  }

  .answer-body :global(h3) {
    font-size: 1.25rem;
    margin-top: 2.15rem;
    margin-bottom: 0.65rem;
    font-weight: 650;
  }

  .answer-body :global(h4) {
    font-size: 1.1rem;
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
    font-weight: 600;
  }

  .answer-body :global(p) {
    margin-bottom: 1.45rem;
  }

  .answer-body :global(p:last-child) {
    margin-bottom: 0;
  }

  /* 列表排版 (ul / ol / li) 现代化精修 */
  .answer-body :global(ul),
  .answer-body :global(ol) {
    margin: 1.5rem 0;
    padding-left: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  /* 无序列表 (ul li) - 微光箭头 / 角标 (Minimal Chevron) */
  .answer-body :global(ul li) {
    position: relative;
    padding-left: 1.5rem;
    line-height: 1.75;
    color: var(--color-text-primary);
  }

  .answer-body :global(ul li::before) {
    content: '';
    position: absolute;
    left: 0.25rem;
    top: 0.7em;
    width: 5.5px;
    height: 5.5px;
    border-top: 1.75px solid var(--color-border-hover);
    border-right: 1.75px solid var(--color-border-hover);
    transform: rotate(45deg);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .answer-body :global(ul li:hover::before) {
    border-color: var(--color-text-primary);
    transform: translateX(3px) rotate(45deg);
  }

  /* 二级嵌套无序列表 */
  .answer-body :global(ul ul),
  .answer-body :global(ol ul) {
    margin: 0.45rem 0 0.2rem;
    gap: 0.45rem;
  }

  .answer-body :global(ul ul li::before) {
    left: 0.3rem;
    width: 4.5px;
    height: 4.5px;
    border-width: 1.25px;
    border-color: var(--color-border);
  }

  .answer-body :global(ul ul li:hover::before) {
    border-color: var(--color-text-secondary);
